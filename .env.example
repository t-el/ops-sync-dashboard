# Copy to .env. Defaults point at the bundled mock APIs, so everything runs offline.

# --- Backend (FastAPI) ---
DATABASE_PATH=backend/data/ops.db
# Real Stripe: STRIPE_API_BASE=https://api.stripe.com and a restricted test key (rk_test_/sk_test_, read-only charges)
STRIPE_API_BASE=http://127.0.0.1:9100/stripe
STRIPE_API_KEY=sk_test_mock
# Help desk (Zendesk-style). Real Zendesk: https://<subdomain>.zendesk.com and an API token
HELPDESK_API_BASE=http://127.0.0.1:9100/helpdesk
HELPDESK_API_KEY=hd_mock
SYNC_INTERVAL_SECONDS=900
SCHEDULER_ENABLED=true
RETRY_ATTEMPTS=3
RETRY_BASE_DELAY=1.0
REQUEST_TIMEOUT=15
# If set, "Sync now" / "Retry" require "Authorization: Bearer <token>" (put the UI behind your SSO/VPN as well)
ADMIN_TOKEN=
CORS_ORIGINS=http://localhost:3000

# --- Frontend (Next.js) ---
BACKEND_URL=http://127.0.0.1:8000
